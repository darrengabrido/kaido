// Copy this file to Secrets.xcconfig (gitignored) and fill in your own values.

// Mapbox public access token — get one at https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN = pk.your_mapbox_public_token_here

// Supabase project credentials — Project Settings -> API in the Supabase dashboard.
// Use the "anon"/"public" key, never the "service_role" secret key.
// Host only, no "https://" prefix — xcconfig treats "//" as a comment marker and would
// silently truncate the URL. The app adds the scheme itself.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your_supabase_anon_key_here

// Spotify app Client ID — https://developer.spotify.com/dashboard
// The app's Redirect URI must be registered there as: vector://spotify-callback
SPOTIFY_CLIENT_ID = your_spotify_client_id_here
