<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Kaido</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.oaktreehouse.kaido.spotify</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>kaido</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>spotify</string>
	</array>
	<key>MBXAccessToken</key>
	<string>$(MAPBOX_ACCESS_TOKEN)</string>
	<key>NSAppleMusicUsageDescription</key>
	<string>Kaido shows what's playing and lets you control playback from the map so you don't have to leave the app.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Kaido connects to your bike over Bluetooth to show live speed and battery data.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Kaido needs your location to track your ride and keep navigating while your phone is locked or in your pocket.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Kaido needs your location to show you on the map and provide turn-by-turn navigation.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Kaido uses the microphone so you can dictate a quick message to your Ride Together group.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Kaido uses speech recognition to turn your dictated Ride Together messages into text before you send them.</string>
	<key>OpenAIAPIKey</key>
	<string>$(OPENAI_API_KEY)</string>
	<key>SpotifyClientID</key>
	<string>$(SPOTIFY_CLIENT_ID)</string>
	<key>SupabaseAnonKey</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>SupabaseHost</key>
	<string>$(SUPABASE_HOST)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>bluetooth-central</string>
		<string>remote-notification</string>
		<string>audio</string>
	</array>
	<key>UILaunchScreen</key>
	<dict/>
</dict>
</plist>
